# Without a key, the chat falls back to a deterministic rule-based reader
# (see services/ai/priority-extraction.ts).
# AI provider (any OpenAI-compatible API, e.g. Mistral). Leave the key empty to run without AI.
AI_API_KEY=
AI_BASE_URL=https://api.mistral.ai/v1
AI_MODEL=mistral-small-latest

# Public site URL used for metadata, sitemap, and robots.txt generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstash Redis REST credentials for shared, multi-instance-safe rate
# limiting (see lib/rate-limit/). Optional: without both, rate limiting
# falls back to a single-process in-memory limiter — correct for local
# development and a single running instance, but not for a horizontally
# scaled deployment (e.g. multiple Vercel instances).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase project credentials for DATA access (accounts, saved searches).
# Optional: without both, that data falls back to in-memory mock
# repositories (services/persistence/). Setting both switches to real,
# durable storage automatically — no code changes. Use the secret key, not
# the publishable one — this app only talks to the database from the
# server. See docs/supabase-setup.md for the one-time migration to run
# before setting these.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Supabase project credentials for AUTH (real sign-up/sign-in/OAuth). This
# is a separate pair from the two above: the anon/publishable key is safe
# to expose to the browser by design (it's what every Supabase Auth call —
# sign up, sign in, OAuth redirect — goes through), unlike the secret key.
# Same project, typically the same URL as SUPABASE_URL. Required for any
# sign-in to work at all — without both set, the sign-in form shows an
# honest "not configured" message rather than a broken one. See
# docs/supabase-auth-setup.md for the one-time migration
# (supabase/migrations/0002_auth.sql) and Dashboard configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Enables the "Continue with Google" / "Continue with Microsoft" buttons on
# the sign-in form. Each is independently optional and defaults to off —
# only set one to "true" once you've actually configured that provider in
# the Supabase Dashboard (Authentication → Providers) with its real client
# ID/secret from Google Cloud Console / Microsoft Entra ID. Leaving these
# unset (rather than showing the button regardless) is deliberate: a button
# for a provider that isn't really configured would fail for every user who
# clicks it.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=
NEXT_PUBLIC_AUTH_MICROSOFT_ENABLED=
