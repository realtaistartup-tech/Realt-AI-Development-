# OpenAI API key used for priority-extraction via the Responses API.
# Optional: without it, priority extraction falls back to a deterministic
# rule-based reader (see services/ai/priority-extraction.ts).
OPENAI_API_KEY=

# Optional override for the model used by services/ai/client.ts.
OPENAI_MODEL=gpt-4.1-mini

# Public site URL used for metadata, sitemap, and robots.txt generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstash Redis REST credentials for shared, multi-instance-safe rate
# limiting (see lib/rate-limit/). Optional: without both, rate limiting
# falls back to a single-process in-memory limiter — correct for local
# development and a single running instance, but not for a horizontally
# scaled deployment (e.g. multiple Vercel instances).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret used to sign the mock-authentication session cookie (see
# lib/session.ts). Required in production — without it, sessions fall back
# to a hardcoded development secret and log a warning on every request.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Supabase project credentials. Optional: without both, accounts and saved
# searches fall back to in-memory mock repositories (services/persistence/).
# Setting both switches to real, durable storage automatically — no code
# changes. Use the secret key, not the publishable one (this app only talks
# to Supabase from the server). See docs/supabase-setup.md for the one-time
# migration you need to run before setting these.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
