# OpenAI API key used for priority-extraction via the Responses API.
# Optional: without it, priority extraction falls back to a deterministic
# rule-based reader (see services/ai/priority-extraction.ts).
OPENAI_API_KEY=

# Optional override for the model used by services/ai/client.ts.
OPENAI_MODEL=gpt-4.1-mini

# Public site URL used for metadata, sitemap, and robots.txt generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstash Redis REST credentials for shared, multi-instance-safe rate
# limiting (see lib/rate-limit/). Optional: without both, rate limiting
# falls back to a single-process in-memory limiter — correct for local
# development and a single running instance, but not for a horizontally
# scaled deployment (e.g. multiple Vercel instances).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
